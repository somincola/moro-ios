    "widget.overview.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto ansehen und direkt einen Beitrag verfassen oder Mitteilungen öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See your account and jump straight to a new post or notifications."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta tu cuenta y crea una publicación o abre las notificaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultez votre compte, rédigez une publication ou ouvrez les notifications."
          }
