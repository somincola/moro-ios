    "widget.comfort.accessibility" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moro Soft Garden. Take it slow. You're doing fine."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moro 治愈花园。慢慢来，也很好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moro 治癒花園。慢慢來，也很好。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moro Sanfter Garten. Lass dir Zeit. Du machst das gut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jardín tranquilo de Moro. Ve con calma. Lo estás haciendo bien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jardin paisible Moro. Prenez votre temps. Tout va bien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giardino sereno Moro. Prenditi il tuo tempo. Stai andando bene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moro やすらぎの庭。ゆっくりで大丈夫。よく頑張っています。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jardim tranquilo do Moro. Vai com calma. Estás a fazer bem."
          }
        }
      }
    },
    "widget.comfort.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gentle pocket garden made only to soften your Home Screen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一座只为装点桌面、让心情柔软一点的口袋花园。"
