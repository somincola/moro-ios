    "widget.comfort.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Drucke für deinen Home-Bildschirm: ein kleiner Elefant unter einem Blatt und Elefanten im Regenwald."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two prints for your Home Screen: a little elephant under a leaf and elephants walking through the rainforest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos estampas para tu pantalla de inicio: un elefantito bajo una hoja y elefantes que pasean por la selva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deux estampes pour votre écran d’accueil : un éléphanteau sous une feuille et des éléphants en promenade dans la forêt tropicale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due stampe per la schermata Home: un elefantino sotto una foglia ed elefanti in cammino nella foresta pluviale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホーム画面に飾る2枚の版画。葉の下で休む子ゾウと、熱帯雨林を歩くゾウたち。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duas gravuras para o ecrã principal: um elefante pequeno debaixo de uma folha e elefantes a passear pela floresta tropical."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两幅主屏版画：绿叶下歇脚的小象，热带雨林中漫步的象群。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩幅主畫面版畫：綠葉下歇腳的小象，熱帶雨林中漫步的象群。"
          }
        }
      }
    },
