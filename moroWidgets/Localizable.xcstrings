    "widget.actions.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where would you like to go?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想从哪里开始？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想從哪裡開始？"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wohin möchtest du?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Adónde quieres ir?"
          }
        },
        "fr" : {
          "stringUnit" : {
