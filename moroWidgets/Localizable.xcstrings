    "widget.comfort.leaf" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kleiner Elefant ruht unter einem großen grünen Blatt neben roten Blüten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A little elephant rests under a broad green leaf beside red flowers."
