          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein sanfter kleiner Garten, der deinen Home-Bildschirm verschönert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pequeño jardín para dar calma a tu pantalla de inicio."
