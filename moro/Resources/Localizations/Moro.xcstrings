    "post.quotePending.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Auf Mastodon kann jeder festlegen, wer seine Beiträge zitieren darf. Dieser Beitrag wird veröffentlicht, sobald der ursprüngliche Autor zustimmt." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "On Mastodon, people can control who may quote their posts. This post will be published after the original author approves it." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "En Mastodon, cada persona puede controlar quién cita sus publicaciones. Esta publicación se publicará cuando la autorice la persona autora original." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Sur Mastodon, chacun peut contrôler qui peut citer ses publications. Cette publication sera publiée après l’accord de l’auteur d’origine." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Su Mastodon, ogni persona può controllare chi può citare i suoi post. Questo post sarà pubblicato dopo l’approvazione dell’autore originale." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Mastodonでは、自分の投稿を引用できる相手を制御できます。この投稿は、元の投稿者が承認すると公開されます。" } },
        "pt-PT" : { "stringUnit" : { "state" : "translated", "value" : "No Mastodon, cada pessoa pode controlar quem pode citar as suas publicações. Esta publicação será publicada após a aprovação do autor original." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在 Mastodon 上，你可以控制其他人引用你嘟文的权限。此嘟文在得到原作者同意后就会发布。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在 Mastodon 上，你可以控制其他人引用你嘟文的權限。此嘟文在得到原作者同意後就會發佈。" } }
      }
    },
    "post.quotePending.title" : {
