    "mentionUser.block.message" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchtest du @%@ wirklich blockieren? Du wirst keine Inhalte mehr von dieser Person sehen, und sie kann dir nicht mehr folgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to block @%@? You will no longer see any content from them, and they cannot follow you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seguro que quieres bloquear a @%@? Dejarás de ver cualquier contenido suyo y no podrá seguirte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous vraiment bloquer @%@ ? Vous ne verrez plus aucun contenu de cet utilisateur, et il ne pourra pas vous suivre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sicuro di voler bloccare @%@? Non vedrai più alcun contenuto da questo utente e non potrà seguirti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "@%@ をブロックしますか？ブロックすると、このユーザーのコンテンツは表示されなくなり、あなたをフォローすることもできなくなります。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem a certeza que pretende bloquear @%@? Deixará de ver qualquer conteúdo deste utilizador e este não poderá seguir-lhe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确定要屏蔽 @%@ 吗？屏蔽后，你将不再看到该用户的任何内容，该用户也无法关注你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確定要封鎖 @%@ 嗎？封鎖後，你將不再看到該使用者的任何內容，該使用者也無法追蹤你。"
          }
        }
      }
    },
