    "notifications.policy.settingsHint" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Quellrichtlinie und Mitteilungstypen kannst du unter Einstellungen > Mitteilungen anpassen."
