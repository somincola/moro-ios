    "appSupport.preservedData" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录账号、草稿及附件、设置、书签和阅读记录都会保留。不会删除服务器上的帖子或个人资料。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登入帳號、草稿及附件、設定、書籤和閱讀紀錄都會保留。不會刪除伺服器上的貼文或個人資料。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accounts, drafts and their attachments, settings, bookmarks and reading history are kept. Posts and profiles on your server are unaffected."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウント、下書きと添付ファイル、設定、ブックマーク、閲覧履歴は保持されます。サーバー上の投稿やプロフィールは削除されません。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konten, Entwürfe samt Anhängen, Einstellungen, Lesezeichen und Lesefortschritt bleiben erhalten. Beiträge und Profile auf dem Server bleiben unverändert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les comptes, brouillons et pièces jointes, réglages, marque-pages et historique sont conservés. Les publications et profils sur le serveur restent intacts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se conservarán cuentas, borradores y adjuntos, ajustes, marcadores e historial de lectura. No se borrarán publicaciones ni perfiles del servidor."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Account, bozze e allegati, impostazioni, segnalibri e cronologia di lettura vengono conservati. Post e profili sul server non vengono modificati."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As contas, rascunhos e anexos, definições, marcadores e histórico de leitura são mantidos. As publicações e perfis no servidor não são afetados."
          }
        }
      }
    },
