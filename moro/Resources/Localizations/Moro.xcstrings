    "notifSettings.intake.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server wendet diese Regeln an, bevor Mitteilungen deinen Posteingang erreichen. Gefilterte Mitteilungen werden zur Prüfung zurückgehalten; verworfene Mitteilungen werden nicht erstellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server applies these rules before notifications reach your inbox. Filtered notifications are held for review; dropped notifications are not created."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor aplica estas reglas antes de que las notificaciones lleguen a tu bandeja. Las filtradas se guardan para revisión; las descartadas no se crean."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur applique ces règles avant que les notifications n’atteignent votre boîte de réception. Les notifications filtrées sont conservées pour examen ; celles ignorées ne sont pas créées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server applica queste regole prima che le notifiche raggiungano la posta in arrivo. Le notifiche filtrate vengono trattenute per la revisione; quelle scartate non vengono create."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知が受信トレイに届く前に、サーバーがこれらのルールを適用します。フィルターされた通知は確認用に保留され、破棄された通知は作成されません。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor aplica estas regras antes de as notificações chegarem à caixa de entrada. As notificações filtradas ficam retidas para revisão; as descartadas não são criadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器会在通知进入收件箱前应用这些规则。被过滤的通知会留待审核；被丢弃的通知不会创建。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器會在通知進入收件匣前套用這些規則。被過濾的通知會留待審核；被丟棄的通知不會建立。"
          }
        }
      }
    },
