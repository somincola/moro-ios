    "compose.camera.accessMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Moro in den Einstellungen den Zugriff auf die Kamera, um Fotos aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Moro to use the camera in Settings to take photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que Moro use la cámara en Ajustes para hacer fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Moro à utiliser l’appareil photo dans Réglages pour prendre des photos."
