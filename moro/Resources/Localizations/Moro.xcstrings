    "appSupport.cacheDetail" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包含下载的图片、头像、背景图和时间轴副本，之后浏览时会重新加载。图片缓存会自动限制大小并清理过期内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包含下載的圖片、頭像、背景圖和時間軸副本，之後瀏覽時會重新載入。圖片快取會自動限制大小並清理過期內容。"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloaded images, avatars, banners and timeline copies will reload as you browse. Image caches have automatic size and age limits."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロード済みの画像、アイコン、ヘッダー画像、タイムラインは閲覧時に再読み込みされます。画像キャッシュには容量と保存期間の上限があります。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder, Avatare, Banner und Timeline-Kopien werden beim Lesen erneut geladen. Bild-Caches werden nach Größe und Alter begrenzt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images, avatars, bannières et copies des fils seront rechargés à la consultation. Les caches d’images sont limités en taille et en durée."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las imágenes, avatares, cabeceras y cronologías se cargarán de nuevo al navegar. La caché de imágenes tiene límites de tamaño y antigüedad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immagini, avatar, copertine e copie delle timeline verranno ricaricati durante la navigazione. La cache delle immagini ha limiti di spazio e durata."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As imagens, avatares, cabeçalhos e cópias das cronologias serão carregados ao navegar. A cache de imagens tem limites de tamanho e duração."
          }
        }
      }
    },
