    "notifications.policy.defaultMessage" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die aktuelle In-App-Mitteilungsrichtlinie hat zuletzt abgerufene Mitteilungen ausgeblendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Current in-app notification policy hid recently fetched notifications."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La política de notificaciones actual de la app ocultó notificaciones obtenidas recientemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La politique de notifications actuelle a masqué des notifications récemment récupérées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La policy per le notifiche in-app attuale ha nascosto le notifiche recuperate di recente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のアプリ内通知ポリシーにより、最近取得した通知が非表示になっています。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A política de notificações atual na aplicação ocultou notificações obtidas recentemente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前应用内通知策略隐藏了最近拉取的通知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前應用程式內通知策略隱藏了最近擷取的通知。"
          }
        }
      }
    },
