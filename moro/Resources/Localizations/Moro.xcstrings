    "display.color.custom.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Farbe wird an helle und dunkle Hintergründe angepasst, damit sie gut lesbar bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your chosen color adapts to light and dark backgrounds to stay readable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tonalidad se adapta a fondos claros y oscuros para mantener la legibilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre couleur s’adapte aux fonds clairs et sombres pour rester lisible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tonalità scelta si adatta agli sfondi chiari e scuri per rimanere leggibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだ色は、読みやすさを保つため背景の明るさに合わせて調整されます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cor escolhida adapta-se aos fundos claros e escuros para manter a legibilidade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选颜色会适应浅色和深色背景，保持清晰可读。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所選顏色會適應淺色與深色背景，保持清晰易讀。"
          }
        }
      }
    },
