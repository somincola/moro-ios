    "bookmarkReading.scope" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche und Filter gelten für geladene Lesezeichen. Die letzten 200 Beitragstexte bleiben auf diesem Gerät; Bilder und Videos benötigen eine Verbindung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search and filters apply to loaded bookmarks. The latest 200 post bodies are kept on this device; images and videos require a connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La búsqueda y los filtros se aplican a los marcadores cargados. Se guardan los últimos 200 textos en este dispositivo; las imágenes y los vídeos requieren conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche et les filtres concernent les signets chargés. Les 200 derniers textes sont conservés sur cet appareil ; les images et vidéos nécessitent une connexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricerca e filtri si applicano ai segnalibri caricati. Gli ultimi 200 testi restano sul dispositivo; immagini e video richiedono una connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索と絞り込みは読み込み済みのブックマークが対象です。最近の200件の本文を端末に保存します。画像と動画には通信が必要です。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pesquisa e os filtros aplicam-se aos marcadores carregados. Os últimos 200 textos ficam neste dispositivo; imagens e vídeos precisam de ligação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索和筛选适用于已载入的书签。最近 200 篇正文会保留在本机，图片和视频需联网加载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜尋和篩選適用於已載入的書籤。最近 200 篇內文會保留在本機，圖片和影片需連線載入。"
          }
        }
      }
