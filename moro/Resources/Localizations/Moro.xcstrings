      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du das aktuelle Konto entfernst, wird automatisch zu einem anderen gewechselt. Falls kein weiteres Konto vorhanden ist, gelangst du zur Anmeldeseite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removing the current account will auto-switch to another; if none, you will return to login."
