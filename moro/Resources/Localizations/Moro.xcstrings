    "post.delete.confirm.message" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Löschen dieses Beitrags kann nicht rückgängig gemacht werden. Favoriten und Boosts gehen verloren, und Antworten verlieren möglicherweise ihren ursprünglichen Kontext."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting this post cannot be undone. Favorites and boosts will be lost, and replies may lose their original context."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar esta publicación no se puede deshacer. Se perderán los favoritos e impulsos, y las respuestas pueden perder su contexto original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression de ce message est irréversible. Les favoris et boosts seront perdus, et les réponses pourraient perdre leur contexte d'origine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'eliminazione non può essere annullata. I preferiti e i boost andranno persi e le risposte potrebbero perdere il contesto originale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除すると元に戻せません。お気に入りやブーストが失われ、返信の文脈が失われる場合があります。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A eliminação desta publicação não pode ser desfeita. Os favoritos e as partilhas serão perdidos, e as respostas podem perder o contexto original."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除后无法撤销，点赞和转发会丢失，原帖下的回复也可能失去原有上下文。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除後無法復原，喜歡數與轉發數將會消失，原文下的回覆也可能失去原有上下文。"
          }
        }
      }
    },
