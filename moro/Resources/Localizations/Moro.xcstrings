    "post.quoteUnavailable.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der zitierte Beitrag wurde möglicherweise gelöscht, die Freigabe wurde widerrufen oder du darfst ihn nicht sehen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The quoted post may have been deleted, its approval withdrawn, or you may not have permission to view it." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La publicación citada puede haberse eliminado, su autorización puede haberse retirado o quizá no tengas permiso para verla." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La publication citée a peut-être été supprimée, son autorisation retirée, ou vous n’avez pas la permission de la voir." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Il post citato potrebbe essere stato eliminato, la sua approvazione revocata oppure potresti non avere il permesso di visualizzarlo." } },
