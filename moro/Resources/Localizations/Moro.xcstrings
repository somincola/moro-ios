          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression du compte actuel bascule automatiquement vers un autre compte ; si aucun autre compte n'existe, vous serez renvoyé à la page de connexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovendo l'account corrente si passerà automaticamente a un altro; se non ce ne sono altri, tornerai alla schermata di accesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のアカウントを削除すると、自動的に別のアカウントに切り替わります。他にアカウントがない場合はログイン画面に戻ります。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao remover a conta atual, será mudado automaticamente para outra; se não existir nenhuma, voltará ao início de sessão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除当前账号后会自动切换到其他账号；如果没有其他账号，将返回登录页。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除目前帳號後會自動切換到其他帳號；若沒有其他帳號，將返回登入頁面。"
          }
        }
      }
    },
