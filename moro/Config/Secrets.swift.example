//
//  Secrets.swift.example
//  moro
//
//  Template only — NOT compiled (the .example extension keeps it out of the build).
//
//  moro does NOT need any build-time secrets: OAuth applications are registered
//  with each Mastodon instance at runtime (POST /api/v1/apps in AuthService), and
//  the per-install client id/secret live in memory only.
//
//  If you ever need a real build-time secret, copy this to `Secrets.swift`
//  (which is git-ignored) and fill in the values:
//
//  import Foundation
//
//  enum Secrets {
//      static let example = "YOUR_VALUE"
//  }
