            "value": "取消"
          }
        }
      }
    },
    "share.action.open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Moro"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Moro"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 Moro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Moroを開く"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir Moro"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Moro öffnen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Moro"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Moro"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Moro"
          }
        }
      }
    },
    "share.action.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut versuchen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprova"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reintentar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentar novamente"
          }
        }
      }
    },
    "share.error.importFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not prepare this share. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享内容准备失败，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享內容準備失敗，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有内容を準備できませんでした。再試行してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de préparer ce partage. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Freigabe konnte nicht vorbereitet werden. Versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile preparare la condivisione. Riprova."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo preparar el contenido. Vuelve a intentarlo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível preparar a partilha. Tente novamente."
          }
        }
      }
    },
    "share.error.noContent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No URL, text, or images detected to import."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检测到可导入的 URL、文字或图片。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune URL, texte ou image détecté à importer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポートできる URL、テキスト、または画像が見つかりませんでした。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine URL, kein Text und keine Bilder zum Importieren gefunden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun URL, testo o immagine rilevato da importare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se detectaron URL, texto ni imágenes para importar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi detetado nenhum URL, texto ou imagem para importar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未偵測到可匯入的 URL、文字或圖片。"
          }
        }
      }
    },
    "share.error.openFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not open Moro automatically. Your content is ready. Retry, or switch to Moro to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能自动打开 Moro。分享内容已准备好，可重试或切回 Moro 继续发帖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能自動開啟 Moro。分享內容已準備好，可重試或切回 Moro 繼續發文。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Moroを自動的に開けませんでした。内容は準備できています。再試行するか、Moroに切り替えてください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir Moro automatiquement. Le contenu est prêt. Réessayez ou passez à Moro pour continuer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Moro konnte nicht automatisch geöffnet werden. Die Inhalte sind bereit. Versuche es erneut oder wechsle zu Moro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire Moro automaticamente. Il contenuto è pronto. Riprova o passa a Moro per continuare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir Moro automáticamente. El contenido está listo. Reintenta o cambia a Moro para continuar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir o Moro automaticamente. O conteúdo está pronto. Tente novamente ou mude para o Moro."
          }
        }
      }
    },
    "share.error.tooManyImages": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can share up to 4 images at a time. Select fewer images and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次最多分享 4 张图片，请减少图片后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次最多分享 4 張圖片，請減少圖片後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度に共有できる画像は4枚までです。枚数を減らして再試行してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez partager jusqu’à 4 images à la fois. Réduisez la sélection et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst bis zu 4 Bilder gleichzeitig teilen. Wähle weniger Bilder und versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi condividere fino a 4 immagini alla volta. Riduci la selezione e riprova."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes compartir hasta 4 imágenes a la vez. Selecciona menos imágenes y vuelve a intentarlo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode partilhar até 4 imagens de cada vez. Reduza a seleção e tente novamente."
          }
        }
      }
    },
    "share.error.unreadableImage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read one of the images. Try sharing again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有图片无法读取，请重新分享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有圖片無法讀取，請重新分享。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込めない画像があります。もう一度共有してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une image n’a pas pu être lue. Réessayez de partager."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bild konnte nicht gelesen werden. Versuche es erneut zu teilen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere un’immagine. Prova a condividerla di nuovo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer una imagen. Vuelve a compartirla."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler uma imagem. Tente partilhá-la novamente."
          }
        }
      }
    },
    "share.state.loading": {
      "extractionState": "manual",
      "localizations": {
