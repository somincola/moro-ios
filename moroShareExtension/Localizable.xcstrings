{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "share.action.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "share.action.import": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save to drafts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存到草稿"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer dans les brouillons"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下書きに保存"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Entwurf speichern"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva nelle bozze"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar en borradores"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar em rascunhos"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存至草稿"
          }
        }
      }
    },
    "share.error.importFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save failed. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存失败，请重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement a échoué. Veuillez réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存できませんでした。もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern fehlgeschlagen. Bitte versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvataggio non riuscito. Riprova."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error al guardar. Inténtalo de nuevo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao guardar. Tente novamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存失敗，請重試。"
          }
        }
      }
    },
    "share.error.noContent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No URL, text, or images detected to import."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检测到可导入的 URL、文字或图片。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune URL, texte ou image détecté à importer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポートできる URL、テキスト、または画像が見つかりませんでした。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine URL, kein Text und keine Bilder zum Importieren gefunden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun URL, testo o immagine rilevato da importare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se detectaron URL, texto ni imágenes para importar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi detetado nenhum URL, texto ou imagem para importar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未偵測到可匯入的 URL、文字或圖片。"
          }
        }
      }
    },
    "share.error.notLoggedIn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please sign in to Moro before using share import."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先登录 Moro，再使用分享导入。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez vous connecter à Moro avant d'utiliser l'importation par partage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有インポートを使用する前に、Moro にサインインしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte melde dich zuerst in Moro an, bevor du die Teilen-Funktion verwendest."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi a Moro prima di usare l'importazione dalla condivisione."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en Moro antes de usar la importación compartida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão no Moro antes de utilizar a importação por partilha."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先登入 Moro，再使用分享匯入。"
          }
        }
      }
    },
    "share.error.notReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared content isn't ready yet. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享内容还未准备完成，请稍后重试。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu partagé n'est pas encore prêt. Veuillez réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有コンテンツの準備がまだ完了していません。後でもう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der geteilte Inhalt ist noch nicht bereit. Bitte versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto condiviso non è ancora pronto. Riprova."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido compartido aún no está listo. Inténtalo de nuevo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo partilhado ainda não está pronto. Tente novamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享內容尚未準備完成，請稍後重試。"
          }
        }
      }
    },
    "share.state.importComplete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved to Moro drafts.\nIt will be restored in Compose when you return."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存到 Moro 草稿。\n回到 app 后会自动恢复到 Compose。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré dans les brouillons Moro.\nIl sera restauré dans Compose à votre retour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Moro の下書きに保存しました。\nアプリに戻ると、投稿作成画面が自動的に復元されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Moro-Entwürfen gespeichert.\nWenn du zur App zurückkehrst, wird der Entwurf automatisch im Verfassen-Bereich wiederhergestellt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvato nelle bozze di Moro.\nVerrà ripristinato in Componi quando torni all'app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado en los borradores de Moro.\nSe restaurará en Redactar cuando vuelvas a la app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado nos rascunhos do Moro.\nSerá restaurado no Compose quando regressar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存至 Moro 草稿。\n回到 app 後會自動還原至 Compose。"
          }
        }
      }
    },
    "share.state.importing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving to Moro drafts…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保存到 Moro 草稿…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement dans les brouillons Moro…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Moro の下書きに保存中…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird in Moro-Entwürfen gespeichert …"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvataggio nelle bozze di Moro…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardando en los borradores de Moro…"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A guardar nos rascunhos do Moro…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在儲存至 Moro 草稿…"
          }
        }
      }
    },
    "share.state.loading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading shared content…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取共享内容…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture du contenu partagé…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有コンテンツを読み込み中…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geteilter Inhalt wird geladen …"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lettura del contenuto condiviso…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leyendo contenido compartido…"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A ler o conteúdo partilhado…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在讀取共享內容…"
          }
        }
      }
    },
    "share.state.ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready: %@\nSave, then switch back to Moro to keep editing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已准备：%@\n保存后，请切回 Moro 继续编辑。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prêt : %@\nEnregistrez, puis revenez sur Moro pour continuer à éditer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備完了：%@\n保存後、Moro に戻って編集を続けてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereit: %@\nSpeichern und dann zu Moro wechseln, um weiterzubearbeiten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto: %@\nSalva, poi torna a Moro per continuare a modificare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo: %@\nGuarda y vuelve a Moro para seguir editando."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto: %@\nGuarde e regresse ao Moro para continuar a editar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已就緒：%@\n儲存後，請切回 Moro 繼續編輯。"
          }
        }
      }
    },
    "share.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import to Moro"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入到 Moro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer dans Moro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Moro にインポート"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In Moro importieren"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa in Moro"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar a Moro"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar para o Moro"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入至 Moro"
          }
        }
      }
    }
  },
  "version": "1.0"
}